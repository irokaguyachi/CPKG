.mcp.json
.r2_config.json
.env
*.env

# Cloudflare Workers local cache/state
worker/.wrangler/
.wrangler/

# 배포용 빌드 산출물(난독화된 dist/js 포함) — build.js가 매번 새로 생성하므로
# 커밋하지 않는다. 배포 대상은 항상 이 폴더를 새로 빌드해서 만든다.
/dist/
node_modules/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary scratch scripts & logs
scratch/
*.tmp
*.log

# Python virtual environment
.venv/
__pycache__/

# Agent internal files — only rules/tag.md should be published
# .agent/rules/*


# Src File
src/assets

# Data Folder
src/data/번역 정리

# 크롤링 첨부 사진 원본 스테이징 폴더 — 실제 서빙되는 이미지는 큐레이션 후
# src/assets/Image/(이미 gitignore됨)로 옮겨져 R2로 관리되므로, 여기 원본
# 스테이징 사본은 git에 넣지 않는다.
src/data/문학 정리/사진

